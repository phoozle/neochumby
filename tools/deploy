#!/bin/sh
# Builds the tree (tools/tree, with the APPs given) and installs it in a
# neochumbyd's state directory on HOST, with neochumbyd itself beside it.
# What is already there and not in this tree (game data, other apps) is
# left alone. rsync puts each file in under a temporary name and renames
# them all at the end; a Chumby running a replaced binary is told its file
# went stale, so stop what it runs first, or restart it: with --restart,
# each Chumby NAMEd is asked over ssh (`neochumbyd restart NAME` on HOST) to
# end its apps and start its session again from the new tree. With --tree
# DIR, a tree tools/tree already built is installed instead (dev/emulate
# --device does this).
#
#   tools/deploy HOST [APP ...] [--tree DIR] [--restart NAME ...]
#                                  NEOCHUMBYD_DIR: default /var/lib/neochumbyd
#                                  (zig on PATH)
set -eu
usage="usage: tools/deploy HOST [APP ...] [--tree DIR] [--restart NAME ...]"
host=${1:?$usage}
shift
dir=${NEOCHUMBYD_DIR:-/var/lib/neochumbyd}

# The APPs stay in "$@"; the NAMEs after --restart are collected apart.
names=
restart=
built=
n=$#
while [ "$n" -gt 0 ]; do
  a=$1
  shift
  n=$((n - 1))
  if [ "$a" = --tree ] && [ "$n" -gt 0 ]; then
    built=$(cd "$1" && pwd)
    shift
    n=$((n - 1))
  elif [ "$a" = --restart ]; then
    restart=1
  elif [ -n "$restart" ]; then
    case $a in
    *[!a-z0-9_-]* | '') echo "$usage: not a Chumby's name: $a" >&2 && exit 2 ;;
    esac
    names="$names $a"
  else
    set -- "$@" "$a"
  fi
done
[ -n "$restart" ] && [ -z "$names" ] && echo "$usage" >&2 && exit 2
root=$(git rev-parse --show-toplevel)
cd "$root"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

if [ -n "$built" ]; then
  cp -R "$built" "$tmp/tree"
else
  tools/tree "$tmp/tree" "$@"
fi
cargo neochumbyd
# Keeping its time: an unchanged binary is then not sent, nor the daemon
# restarted.
cp -p target/x86_64-unknown-linux-musl/release/neochumbyd "$tmp/"

rsync -rlpt --delay-updates "$tmp/tree/" "$host:$dir/tree/"
rsync -pt --delay-updates "$tmp/neochumbyd" "$host:$dir/neochumbyd"

# A restarted daemon (a new binary) takes a few seconds before each Chumby
# is back; neochumbyd restart waits for it.
for name in $names; do
  ssh "$host" "'$dir/neochumbyd' restart $name --state '$dir'"
done
