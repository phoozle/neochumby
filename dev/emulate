REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
W, H = 320, 240
FB_BYTES = W * H * 2
# The stock calibration (/psp/ts_settings), the same fallback as
# neochumby::input::Calibration.
STOCK_CAL = (169, 3733, 4082, -4054, False)
# The ELF header of a 32-bit little-endian ARM executable, as binfmt_misc
# matches it.
ARM_MAGIC = "7f454c4601010100000000000000000002002800"

CLONE_NEWNS, CLONE_NEWUTS, CLONE_NEWPID = 0x00020000, 0x04000000, 0x20000000
MS_RDONLY, MS_NOSUID, MS_NODEV, MS_NOEXEC = 1, 2, 4, 8
MS_REMOUNT, MS_BIND, MS_REC, MS_PRIVATE = 32, 4096, 16384, 1 << 18

libc = ctypes.CDLL(None, use_errno=True)
libc.mount.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_char_p, ctypes.c_ulong, ctypes.c_char_p]


def _check(r, what):
    if r != 0:
        e = ctypes.get_errno()
        raise OSError(e, f"{what}: {os.strerror(e)}")


def _b(s):
    return s.encode() if isinstance(s, str) else s


def mount(src, target, fstype=None, flags=0, data=None):
    _check(libc.mount(_b(src), _b(target), _b(fstype), flags, _b(data)), f"mount {target}")


def bind(src, target, ro=False):
    """Binds a file or directory over `target`, which must exist."""
    mount(src, target, None, MS_BIND)
    if ro:
        mount(None, target, None, MS_BIND | MS_REMOUNT | MS_RDONLY)


def bind_file(src, target):
    open(target, "a").close()
    bind(src, target)


def unshare(flags):
    _check(libc.unshare(flags), "unshare")


def setns(path, flag):
    fd = os.open(path, os.O_RDONLY)
    try:
        _check(libc.setns(fd, flag), f"setns {path}")
    finally:
        os.close(fd)


# The touchscreen's calibration, and the raw readings for a screen point.


def calibration(psp):
    try:
        with open(os.path.join(psp, "ts_settings")) as f:
            v = [int(x) for x in f.read().strip().split(",")]
        if len(v) == 5 and v[1] and v[3]:
            return (v[0], v[1], v[2], v[3], v[4] != 0)
    except (OSError, ValueError):
        pass
    return STOCK_CAL


def raw_point(cal, x, y):
    """The raw (x, y) that neochumby::input maps to screen pixel (x, y): it
    truncates toward zero, so each axis rounds away from its origin."""
    x0, xspan, y0, yspan, swap = cal

    def axis(v, origin, span, size):
        sign = 1 if span > 0 else -1
        return origin + sign * -(-v * abs(span) // size)

    rx, ry = axis(x, x0, xspan, W), axis(y, y0, yspan, H)
    return (ry, rx) if swap else (rx, ry)


EV_SYN, EV_KEY, EV_ABS = 0, 1, 3
ABS_X, ABS_Y, ABS_PRESSURE, BTN_TOUCH = 0, 1, 0x18, 0x14A


def events(*evs):
    """The 2.6.16 kernel's 32-bit input_event: timeval, type, code, value."""
    t = time.time()
    sec, usec = int(t) & 0xFFFFFFFF, int(t % 1 * 1e6)
    return b"".join(struct.pack("<IIHHi", sec, usec, ty, code, v) for ty, code, v in evs)


def touch_down(rx, ry):
    return events((EV_ABS, ABS_X, rx), (EV_ABS, ABS_Y, ry), (EV_ABS, ABS_PRESSURE, 200), (EV_KEY, BTN_TOUCH, 1),
                  (EV_SYN, 0, 0))


def touch_up():
    return events((EV_ABS, ABS_PRESSURE, 0), (EV_KEY, BTN_TOUCH, 0), (EV_SYN, 0, 0))


# The fake devices, served over FUSE: the kernel's /dev/fuse protocol, the
# few requests a file system of three files needs. Requests are answered
# one at a time from a select() loop, so a read can be left waiting (a
# blocking read of the touchscreen) and a write held back (the speaker's
# pacing) without threads.

FUSE_LOOKUP, FUSE_FORGET, FUSE_GETATTR, FUSE_SETATTR = 1, 2, 3, 4
FUSE_OPEN, FUSE_READ, FUSE_WRITE, FUSE_STATFS, FUSE_RELEASE = 14, 15, 16, 17, 18
FUSE_FSYNC, FUSE_FLUSH, FUSE_INIT, FUSE_OPENDIR, FUSE_READDIR = 20, 25, 26, 27, 28
FUSE_RELEASEDIR, FUSE_ACCESS, FUSE_INTERRUPT, FUSE_DESTROY = 29, 34, 36, 38
FUSE_IOCTL, FUSE_BATCH_FORGET = 39, 42
FOPEN_DIRECT_IO, FOPEN_NONSEEKABLE = 1, 4
FUSE_ATOMIC_O_TRUNC, FUSE_BIG_WRITES = 1 << 3, 1 << 5
MAX_WRITE = 128 * 1024

IN_HEADER = struct.Struct("<IIQQIIII")
OUT_HEADER = struct.Struct("<IiQ")
ATTR = struct.Struct("<QQQQQQIIIIIIIIII")
RW_IN = struct.Struct("<QQIIQII")  # fuse_read_in and fuse_write_in
IOCTL_IN = struct.Struct("<QIIQII")

ROOT, EVENT0, SWITCH, DSP = 1, 2, 3, 4
FILES = {b"event0": EVENT0, b"switch": SWITCH, b"dsp": DSP}
# evdev's buffer on the Chumby's kernel: 64 events per open; older ones go.
EVENT_QUEUE = 64 * 16
# OSS requests (_IOWR('P', n, int)) and formats.
SNDCTL_DSP_SPEED, SNDCTL_DSP_SETFMT, SNDCTL_DSP_CHANNELS = 0xC0045002, 0xC0045005, 0xC0045006
# _IOR('P', 12, audio_buf_info): fragments, fragstotal, fragsize, bytes.
SNDCTL_DSP_GETOSPACE = 0x8010500C
DSP_FRAGMENTS = 4
AFMT_U8, AFMT_S16_LE = 0x08, 0x10
# How far ahead of the sound a writer may get: the driver's buffer.
DSP_AHEAD = 0.25


class Handle:
    def __init__(self, node, flags):
        self.node = node
        self.flags = flags
        self.queue = bytearray()
        # /dev/dsp: 8 kHz unsigned 8-bit mono until set, as OSS starts.
        self.rate, self.channels, self.width = 8000, 1, 1
        self.played_to = 0.0


class Devices:
    def __init__(self, fuse, state):
        self.fuse = fuse
        self.state = state
        self.handles = {}
        self.next_fh = 1
        self.level = 0
        # Blocking reads of the touchscreen waiting for a touch:
        # unique -> (fh, size).
        self.waiting = {}
        # Writes to /dev/dsp held back until the sound catches up.
        self.timers = []
        self.dsp_bytes = 0

    def reply(self, unique, data=b"", err=0):
        try:
            os.write(self.fuse, OUT_HEADER.pack(OUT_HEADER.size + len(data), -err, unique) + data)
        except OSError as e:
            # ENOENT: the request was interrupted and has gone.
            if e.errno != errno.ENOENT:
                raise

    @staticmethod
    def attr(node):
        if node == ROOT:
            mode, nlink = 0o040755, 2
        else:
            mode, nlink = 0o100666, 1
        return ATTR.pack(node, 0, 0, 0, 0, 0, 0, 0, 0, mode, nlink, 0, 0, 0, 4096, 0)

    def open_on(self, node):
        return [h for h in self.handles.values() if h.node == node]

    def touch(self, data):
        """Gives every open of the touchscreen a copy of these events."""
        for h in self.open_on(EVENT0):
            h.queue += data
            del h.queue[: max(0, len(h.queue) - EVENT_QUEUE)]
        for unique, (fh, size) in list(self.waiting.items()):
            if self.handles[fh].queue:
                del self.waiting[unique]
                self.read_events(unique, self.handles[fh], size)

    def read_events(self, unique, h, size):
        n = min(size, len(h.queue)) // 16 * 16
        data = bytes(h.queue[:n])
        del h.queue[:n]
        self.reply(unique, data)

    def handle(self, req):
        length, op, unique, node, _, _, _, _ = IN_HEADER.unpack_from(req)
        body = req[IN_HEADER.size:length]
        if op in (FUSE_FORGET, FUSE_BATCH_FORGET):
            return
        if op == FUSE_INIT:
            major, minor, readahead, _ = struct.unpack_from("<IIII", body)
            out = struct.pack("<IIIIHHIIHHI", 7, min(minor, 31), readahead, FUSE_ATOMIC_O_TRUNC | FUSE_BIG_WRITES, 16,
                              12, MAX_WRITE, 1, 0, 0, 0)
            return self.reply(unique, out + bytes(28))
        if op == FUSE_DESTROY:
            raise SystemExit(0)
        if op == FUSE_LOOKUP:
            child = FILES.get(body.rstrip(b"\0"))
            if node != ROOT or child is None:
                return self.reply(unique, err=errno.ENOENT)
            return self.reply(unique, struct.pack("<QQQQII", child, 0, 3600, 3600, 0, 0) + self.attr(child))
        if op in (FUSE_GETATTR, FUSE_SETATTR):
            return self.reply(unique, struct.pack("<QII", 3600, 0, 0) + self.attr(node))
        if op == FUSE_OPEN:
            (flags,) = struct.unpack_from("<I", body)
            # The button and the speaker are one opener's at a time.
            if node in (SWITCH, DSP) and self.open_on(node):
                return self.reply(unique, err=errno.EBUSY)
            fh = self.next_fh
            self.next_fh += 1
            self.handles[fh] = Handle(node, flags)
            return self.reply(unique, struct.pack("<QII", fh, FOPEN_DIRECT_IO | FOPEN_NONSEEKABLE, 0))
        if op == FUSE_READ:
            fh, _, size, _, _, flags, _ = RW_IN.unpack_from(body)
            h = self.handles.get(fh)
            if h is None:
                return self.reply(unique, err=errno.EBADF)
            if h.node == SWITCH:
                return self.reply(unique, bytes([self.level])[:size])
            if h.node == DSP:
                return self.reply(unique, err=errno.EINVAL)
            if size < 16:
                return self.reply(unique, err=errno.EINVAL)
            if h.queue:
                return self.read_events(unique, h, size)
            if flags & os.O_NONBLOCK:
                return self.reply(unique, err=errno.EAGAIN)
            self.waiting[unique] = (fh, size)
            return
        if op == FUSE_WRITE:
            fh, _, size, _, _, flags, _ = RW_IN.unpack_from(body)
            data = body[RW_IN.size:RW_IN.size + size]
            h = self.handles.get(fh)
            if h is None:
                return self.reply(unique, err=errno.EBADF)
            done = struct.pack("<II", size, 0)
            if h.node == EVENT0:
                # As evdev: whole events, delivered to every reader.
                self.touch(data[: len(data) // 16 * 16])
            elif h.node == SWITCH:
                # As the driver: the button is read, not written. The
                # emulator's control socket moves it.
                return self.reply(unique, err=errno.EINVAL)
            elif h.node == DSP:
                now = time.monotonic()
                start = max(now, h.played_to)
                ahead = start - now
                if ahead > DSP_AHEAD and flags & os.O_NONBLOCK:
                    return self.reply(unique, err=errno.EAGAIN)
                h.played_to = start + size / (h.rate * h.channels * h.width)
                self.dsp_bytes += size
                if ahead > DSP_AHEAD:
                    heapq.heappush(self.timers, (now + ahead - DSP_AHEAD, unique, done))
                    return
            return self.reply(unique, done)
        if op == FUSE_IOCTL:
            fh, _, cmd, _, in_size, out_size = IOCTL_IN.unpack_from(body)
            h = self.handles.get(fh)
            arg = body[IOCTL_IN.size:IOCTL_IN.size + in_size]
            if h is None or h.node != DSP:
                return self.reply(unique, err=errno.ENOTTY)
            if cmd == SNDCTL_DSP_GETOSPACE and out_size >= 16:
                # The buffer is DSP_AHEAD of sound; what is in it, how far
                # the writes are ahead of the sound.
                second = h.rate * h.channels * h.width
                size = int(DSP_AHEAD * second) // DSP_FRAGMENTS
                total = size * DSP_FRAGMENTS
                queued = min(total, int(max(0.0, h.played_to - time.monotonic()) * second))
                free = total - queued
                out = struct.pack("<iiii", free // size, DSP_FRAGMENTS, size, free) + bytes(out_size - 16)
                return self.reply(unique, struct.pack("<iIII", 0, 0, 0, 0) + out)
            if len(arg) < 4 or out_size < 4:
                return self.reply(unique, err=errno.ENOTTY)
            (v,) = struct.unpack_from("<i", arg)
            if cmd == SNDCTL_DSP_SPEED:
                h.rate = max(4000, min(v, 48000))
                v = h.rate
            elif cmd == SNDCTL_DSP_CHANNELS:
                h.channels = max(1, min(v, 2))
                v = h.channels
            elif cmd == SNDCTL_DSP_SETFMT:
                if v not in (AFMT_U8, AFMT_S16_LE):
                    v = AFMT_S16_LE
                h.width = 1 if v == AFMT_U8 else 2
            else:
                return self.reply(unique, err=errno.ENOTTY)
            out = struct.pack("<i", v) + bytes(out_size - 4)
            return self.reply(unique, struct.pack("<iIII", 0, 0, 0, 0) + out)
        if op == FUSE_RELEASE:
            (fh,) = struct.unpack_from("<Q", body)
            self.handles.pop(fh, None)
            for u, (waiting_fh, _) in list(self.waiting.items()):
                if waiting_fh == fh:
                    del self.waiting[u]
                    self.reply(u, err=errno.EBADF)
            return self.reply(unique)
        if op == FUSE_INTERRUPT:
            (gone,) = struct.unpack_from("<Q", body)
            if self.waiting.pop(gone, None) is not None:
                self.reply(gone, err=errno.EINTR)
            return
        if op == FUSE_OPENDIR:
            return self.reply(unique, struct.pack("<QII", 0, 0, 0))
        if op == FUSE_READDIR:
            _, offset, size, _, _, _, _ = RW_IN.unpack_from(body)
            out = b""
            entries = [(b".", ROOT, 4), (b"..", ROOT, 4)] + [(n, i, 8) for n, i in FILES.items()]
            for i, (name, ino, kind) in enumerate(entries[offset:], offset + 1):
                d = struct.pack("<QQII", ino, i, len(name), kind) + name
                d += bytes(-len(d) % 8)
                if len(out) + len(d) > size:
                    break
                out += d
            return self.reply(unique, out)
        if op in (FUSE_RELEASEDIR, FUSE_FLUSH, FUSE_FSYNC, FUSE_ACCESS):
            return self.reply(unique)
        if op == FUSE_STATFS:
            return self.reply(unique, bytes(80))
        return self.reply(unique, err=errno.ENOSYS)

    def fire_timers(self):
        now = time.monotonic()
        while self.timers and self.timers[0][0] <= now:
            _, unique, data = heapq.heappop(self.timers)
            self.reply(unique, data)

    def status(self):
        dsp = self.open_on(DSP)
        return {
            "touch_readers": len(self.open_on(EVENT0)),
            "button": "down" if self.level else "up",
            "button_open": bool(self.open_on(SWITCH)),
            "dsp_open": bool(dsp),
            "dsp_format": [dsp[0].rate, dsp[0].channels, dsp[0].width * 8] if dsp else None,
            "dsp_bytes": self.dsp_bytes,
        }


def serve(fuse, state, init_pipe):
    """The FUSE server and the control socket, until the supervisor ends it.
    The namespace's PID 1 comes over `init_pipe` from the supervisor that
    started it, never from a file."""
    dev = Devices(fuse, state)
    init = None
    ctl = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    path = state.at("ctl")
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    ctl.bind(path)
    # The socket alone is the user's, so the controls work without sudo.
    os.chmod(path, 0o600)
    uid, gid = invoker()
    os.chown(path, uid, gid)
    ctl.listen(4)
    watch = [fuse, ctl, init_pipe]
    while True:
        timeout = max(0.0, dev.timers[0][0] - time.monotonic()) if dev.timers else None
        ready, _, _ = select.select(watch, [], [], timeout)
        if init_pipe in ready:
            got = os.read(init_pipe, 32)
            if got:
                init = int(got)
            watch.remove(init_pipe)
        if fuse in ready:
            try:
                req = os.read(fuse, MAX_WRITE + 4096)
            except OSError as e:
                if e.errno in (errno.EINTR, errno.EAGAIN, errno.ENOENT):
                    continue
                if e.errno == errno.ENODEV:
                    return
                raise
            dev.handle(req)
        if ctl in ready:
            conn, _ = ctl.accept()
            with conn:
                conn.settimeout(2)
                try:
                    words = conn.recv(256).decode().split()
                    conn.sendall((command(dev, state, words, init) + "\n").encode())
                except (OSError, ValueError, IndexError) as e:
                    conn.sendall(f"error {e}\n".encode())
        dev.fire_timers()


def command(dev, state, words, init):
    if words[0] == "touch":
        x, y = int(words[1]), int(words[2])
        dev.touch(touch_down(*raw_point(calibration(state.at("psp")), x, y)))
    elif words[0] == "release":
        dev.touch(touch_up())
    elif words[0] == "button":
        dev.level = 1 if words[1] == "1" else 0
    elif words[0] == "status":
        return "ok " + json.dumps(dev.status())
    elif words[0] == "stop":
        if init:
            os.kill(init, signal.SIGKILL)
    else:
        raise ValueError(f"unknown command {words[0]}")
    return "ok"


# The emulator's directory, and who may touch what in it.


def invoker():
    """The user who ran sudo (or this user): (uid, gid)."""
    uid, gid = os.environ.get("SUDO_UID"), os.environ.get("SUDO_GID")
    if uid and gid and uid.isdigit() and gid.isdigit():
        return int(uid), int(gid)
    return os.getuid(), os.getgid()


class State:
    """The emulator's directory (--state, else $NEOCHUMBY_EMU, else
    /var/tmp/neochumby-emulate-UID, for the user who ran sudo).

    Root uses it only through a descriptor, opened once and checked to be a
    directory of root's that no one else can write: so nothing a user renames
    or plants there changes what root reads, writes, mounts or signals. Each
    namespace needs its own descriptor (a mount made through another
    namespace's is refused), so `reopen` opens it again there and checks that
    it's the same directory. Everything root writes in it stays root's; the
    control socket alone is the user's."""

    def __init__(self, path):
        self.path = os.path.abspath(path)
        self.fd = None
        self.ident = None

    def secure(self, create=False):
        if create:
            try:
                os.mkdir(self.path, 0o755)
            except FileExistsError:
                pass
        try:
            fd = os.open(self.path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        except OSError as e:
            sys.exit(f"dev/emulate: {self.path}: {e.strerror}")
        st = os.fstat(fd)
        if st.st_uid != 0 or st.st_mode & 0o022:
            os.close(fd)
            sys.exit(f"dev/emulate: {self.path} must be root's and writable by no one else; give another --state")
        if self.ident and (st.st_dev, st.st_ino) != self.ident:
            sys.exit(f"dev/emulate: {self.path} was replaced")
        if self.fd is not None:
            os.close(self.fd)
        self.fd, self.ident = fd, (st.st_dev, st.st_ino)

    def reopen(self):
        self.secure()

    def at(self, name):
        if self.fd is None:
            return os.path.join(self.path, name)
        return f"/proc/self/fd/{self.fd}/{name}"


def read(state, name):
    try:
        fd = os.open(state.at(name), os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return None
    with os.fdopen(fd) as f:
        return f.read().strip()


def write(state, name, text, size=None):
    """Writes a file of root's whole: a new file, renamed over the old."""
    path = state.at(name)
    try:
        os.unlink(path + ".new")
    except FileNotFoundError:
        pass
    fd = os.open(path + ".new", os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
    with os.fdopen(fd, "w") as f:
        f.write(text)
        if size is not None:
            f.truncate(size)
    os.rename(path + ".new", path)


def remove(state, name):
    try:
        os.unlink(state.at(name))
    except FileNotFoundError:
        pass


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    return True


def is_ns_init(pid):
    """Whether `pid` is PID 1 of a namespace below ours."""
    try:
        with open(f"/proc/{pid}/status") as f:
            m = re.search(r"^NSpid:\s+(.*)$", f.read(), re.M)
    except OSError:
        return False
    ids = m.group(1).split() if m else []
    return len(ids) >= 2 and ids[-1] == "1"


def running(state):
    """"running", "stale" (the supervisor has gone, but the session's PID 1
    hasn't: it was killed), or None."""
    pid = read(state, "pid")
    if pid and pid.isdigit() and alive(int(pid)):
        return "running"
    init = read(state, "init-pid")
    if init and init.isdigit() and is_ns_init(int(init)):
        return "stale"
    return None


def stale_init(state):
    """The PID 1 a killed supervisor left, checked to be this emulator's: the
    init of the PID namespace it recorded (in root's files). Root only."""
    init, ns = read(state, "init-pid"), read(state, "init-ns")
    if not (init and init.isdigit() and ns and is_ns_init(int(init))):
        return None
    try:
        if str(os.stat(f"/proc/{init}/ns/pid").st_ino) != ns:
            return None
    except OSError:
        return None
    return int(init)


# Starting: the supervisor builds the fake root in a mount namespace, starts
# the FUSE server, and runs the session under an init of its own (PID 1 of a
# PID namespace), so that stopping it ends everything it started.

PT_INTERP = 3


def is_static(path):
    """Whether an ELF executable has no program interpreter: it runs in a
    chroot with nothing of the host's beside it."""
    with open(path, "rb") as f:
        head = f.read(64)
        if head[:4] != b"\x7fELF":
            return False
        if head[4] == 2:
            phoff, = struct.unpack_from("<Q", head, 32)
            phentsize, phnum = struct.unpack_from("<HH", head, 54)
        else:
            phoff, = struct.unpack_from("<I", head, 28)
            phentsize, phnum = struct.unpack_from("<HH", head, 42)
        for i in range(phnum):
            f.seek(phoff + i * phentsize)
            (ptype,) = struct.unpack("<I", f.read(4))
            if ptype == PT_INTERP:
                return False
    return True


def arm_handler():
    """qemu's binfmt_misc entry for ARM: (interpreter, flags)."""
    base = "/proc/sys/fs/binfmt_misc"
    for name in sorted(os.listdir(base)) if os.path.isdir(base) else []:
        try:
            with open(os.path.join(base, name)) as f:
                lines = f.read().split("\n")
        except OSError:
            continue
        info = dict(line.split(" ", 1) for line in lines if " " in line)
        if lines[0] == "enabled" and info.get("magic") == ARM_MAGIC:
            return info.get("interpreter"), info.get("flags:", "")
    return None, ""


def need_root(what):
    if sys.platform != "linux":
        sys.exit("dev/emulate runs on Linux only (namespaces, FUSE and qemu-user); see CONTRIBUTING.md for a Mac")
    if os.geteuid() != 0:
        sys.exit(f"dev/emulate {what}: needs root (sudo): it mounts, and makes namespaces")


def open_regular(path, what):
    """A user-given file root opens: a regular file, not a link to one, nor
    a disk."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError as e:
        sys.exit(f"dev/emulate: {what} {path}: {e.strerror}")
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        sys.exit(f"dev/emulate: {what} {path}: not a regular file")
    return fd


def cmd_start(state, opts, tree):
    need_root("start")
    interp, flags = arm_handler()
    if not interp:
        sys.exit("dev/emulate: no binfmt_misc handler for ARM: install qemu-user-binfmt (or qemu-user-static)")
    if not os.path.exists(interp) or not is_static(interp):
        sys.exit(f"dev/emulate: qemu-arm ({interp}) must be statically linked, to run inside the chroot: "
                 "install qemu-user-binfmt (or qemu-user-static) from Debian or Ubuntu")
    if not os.path.exists("/dev/fuse"):
        sys.exit("dev/emulate: no /dev/fuse (modprobe fuse)")
    if tree and not os.path.isfile(os.path.join(tree, "neochumby")):
        sys.exit(f"dev/emulate: {tree}: no neochumby there (make one with tools/tree)")
    if not tree and not opts["stick"]:
        sys.exit("dev/emulate start: give a TREE, or a --stick holding one")
    stick_fd = None
    if opts["stick"] and not os.path.isdir(opts["stick"]):
        stick_fd = open_regular(opts["stick"], "--stick")
    state.secure(create=True)
    now = running(state)
    if now == "running":
        sys.exit(f"dev/emulate: already running ({state.path}); dev/emulate stop first")
    if now == "stale":
        sys.exit("dev/emulate: the last session is still running, though its supervisor was killed: "
                 "sudo dev/emulate stop")
    for d in ("root", "devices", "sense1", "psp"):
        os.makedirs(state.at(d), mode=0o755, exist_ok=True)
    if opts["psp"]:
        shutil.rmtree(state.at("psp"))
        shutil.copytree(opts["psp"], state.at("psp"), symlinks=True)
    # A fresh, black screen, and the boot's speaker and backlight, each start.
    write(state, "fb0", "", size=FB_BYTES)
    for name, value in (("brightness", "65535"), ("dimlevel", "0"), ("spkmute", "1")):
        write(state, f"sense1/{name}", value + "\n")
    for name in ("exit", "ready", "failed", "init-pid", "init-ns", "pid"):
        remove(state, name)
    write(state, "log", "")
    write(state, "emulate.log", "")

    pid = os.fork()
    if pid == 0:
        os.setsid()
        out = os.open(state.at("emulate.log"), os.O_WRONLY | os.O_APPEND | os.O_NOFOLLOW)
        null = os.open("/dev/null", os.O_RDONLY)
        os.dup2(null, 0)
        os.dup2(out, 1)
        os.dup2(out, 2)
        code = 1
        try:
            supervise(state, opts, tree, stick_fd, interp, "F" in flags)
            code = 0
        except BaseException as e:
            print(f"dev/emulate: {e!r}", flush=True)
            write(state, "failed", str(e))
            for child in CHILDREN:
                os.kill(child, signal.SIGKILL)
        finally:
            os._exit(code)
    deadline = time.monotonic() + 30
    while time.monotonic() < deadline:
        if read(state, "ready") is not None:
            print(f"dev/emulate: running ({state.path}); the session's output: dev/emulate log")
            return
        if read(state, "failed") is not None or os.waitpid(pid, os.WNOHANG)[0]:
            break
        time.sleep(0.1)
    sys.exit(f"dev/emulate: failed to start:\n{read(state, 'emulate.log')}")


# What the supervisor started, to end if it fails part way.
CHILDREN = []


def supervise(state, opts, tree, stick_fd, interp, fixed):
    write(state, "pid", str(os.getpid()))
    unshare(CLONE_NEWNS | CLONE_NEWUTS)
    mount(None, "/", None, MS_REC | MS_PRIVATE)
    state.reopen()
    root = state.at("root")
    socket.sethostname("chumby")
    mount("tmpfs", root, "tmpfs", MS_NOSUID, "mode=755")
    for d in ("dev/input", "mnt/neochumby", "mnt/usb", "psp", "tmp", "proc", "etc", "usr/bin", "bin"):
        os.makedirs(os.path.join(root, d))

    fuse = os.open("/dev/fuse", os.O_RDWR)
    mount("neochumby-emulate", state.at("devices"), "fuse", MS_NOSUID | MS_NODEV,
          f"fd={fuse},rootmode=40000,user_id=0,group_id=0,allow_other")
    init_r, init_w = os.pipe()
    server = os.fork()
    if server == 0:
        try:
            os.close(init_w)
            serve(fuse, state, init_r)
        finally:
            os._exit(0)
    CHILDREN.append(server)
    os.close(fuse)
    os.close(init_r)
    for name, path in (("event0", "dev/input/event0"), ("switch", "dev/switch"), ("dsp", "dev/dsp")):
        bind_file(state.at(f"devices/{name}"), os.path.join(root, path))
    bind_file(state.at("fb0"), os.path.join(root, "dev/fb0"))
    for name in ("null", "zero", "random", "urandom"):
        bind_file(f"/dev/{name}", os.path.join(root, "dev", name))

    if tree:
        bind(os.path.abspath(tree), os.path.join(root, "mnt/neochumby"), ro=True)
    if stick_fd is not None:
        # The image root checked when it opened it, by its descriptor.
        r = subprocess.run(["mount", "-t", "vfat", "-o", "loop", f"/proc/self/fd/{stick_fd}",
                            os.path.join(root, "mnt/usb")], capture_output=True, text=True,
                           pass_fds=(stick_fd, state.fd))
        if r.returncode:
            raise OSError(f"can't loop-mount {opts['stick']}: {r.stderr.strip()} (give a directory as --stick instead)")
    elif opts["stick"]:
        bind(os.path.abspath(opts["stick"]), os.path.join(root, "mnt/usb"))
    bind(state.at("psp"), os.path.join(root, "psp"))
    mount("tmpfs", os.path.join(root, "tmp"), "tmpfs", MS_NOSUID | MS_NODEV, "size=32m,mode=1777")
    # Name lookups work as on the PC, for a neochumbyd given by name.
    for name in ("resolv.conf", "hosts"):
        if os.path.exists(f"/etc/{name}"):
            shutil.copy(f"/etc/{name}", os.path.join(root, "etc", name))
    for host, guest in opts["binds"]:
        target = os.path.join(root, guest.lstrip("/"))
        os.makedirs(target, exist_ok=True)
        bind(host, target, ro=True)
    # Without the F flag, the kernel looks for qemu inside the chroot.
    if not fixed:
        os.makedirs(os.path.join(root, os.path.dirname(interp).lstrip("/")), exist_ok=True)
        bind_file(interp, os.path.join(root, interp.lstrip("/")))

    run = opts["run"] or ("/mnt/neochumby/neochumby" if tree else "/mnt/usb/neochumby/neochumby")
    server_addr, _, api_port = (opts["server"] or "").partition(":")
    env = dict(BASE_ENV)
    # As the boot hook passes them on, empty when there's no neochumbyd.
    env.update({"NEOCHUMBY_SERVER": server_addr, "NEOCHUMBY_API_PORT": api_port})
    env.update(opts["env"])

    unshare(CLONE_NEWPID)
    init = os.fork()
    if init == 0:
        try:
            pid1(state, root, run, env)
        finally:
            os._exit(127)
    CHILDREN.append(init)
    os.write(init_w, str(init).encode())
    os.close(init_w)
    # For `exec`, and for a `stop` after this supervisor is killed.
    write(state, "init-pid", str(init))
    write(state, "init-ns", str(os.stat(f"/proc/{init}/ns/pid").st_ino))
    write(state, "ready", "")
    _, status = os.waitpid(init, 0)
    code = os.waitstatus_to_exitcode(status)
    os.kill(server, signal.SIGTERM)
    os.waitpid(server, 0)
    remove(state, "pid")
    # Last: once it's there, the emulator can be started again.
    write(state, "exit", f"exit {code}" if code >= 0 else f"signal {-code}")


# NEOCHUMBY_JAIL=off: the session can't mount or chroot here (below), so it
# runs the apps unjailed, as root; the jails are tested on a Chumby.
BASE_ENV = {"PATH": "/usr/bin:/bin:/usr/sbin:/sbin", "QEMU_CPU": "arm926", "NEOCHUMBY_JAIL": "off"}

# What the session runs without: root's ways out of a chroot and a mount
# namespace, and into the PC (its devices, kernel, clock, network setup).
# The Chumby's session, as root, needs only to signal its own processes and
# write its files.
CAP_DAC_READ_SEARCH, CAP_SETPCAP, CAP_LINUX_IMMUTABLE, CAP_NET_ADMIN = 2, 8, 9, 12
DROPPED_CAPS = [CAP_DAC_READ_SEARCH, CAP_SETPCAP, CAP_LINUX_IMMUTABLE, CAP_NET_ADMIN] + list(range(16, 23)) + [
    24, 25, 26, 27, 30, 31] + list(range(32, 41))
PR_CAPBSET_DROP, PR_SET_NO_NEW_PRIVS = 24, 38
LINUX_CAPABILITY_VERSION_3 = 0x20080522


def drop_privileges():
    """Before the execve of anything that runs in the fake root: the
    capabilities above go from this process's sets and from its bounding set,
    so the program it runs (root, but not all-powerful) can't get them back."""
    for cap in DROPPED_CAPS:
        # EINVAL: a capability this kernel hasn't got.
        if libc.prctl(PR_CAPBSET_DROP, ctypes.c_ulong(cap), 0, 0, 0) != 0 and ctypes.get_errno() != errno.EINVAL:
            _check(-1, "dropping capabilities")
    header = (ctypes.c_uint32 * 2)(LINUX_CAPABILITY_VERSION_3, 0)
    sets = (ctypes.c_uint32 * 6)()
    _check(libc.capget(header, sets), "capget")
    for cap in DROPPED_CAPS:
        for k in range(3):  # effective, permitted, inheritable
            sets[cap // 32 * 3 + k] &= ~(1 << cap % 32) & 0xFFFFFFFF
    _check(libc.capset(header, sets), "capset")
    _check(libc.prctl(PR_SET_NO_NEW_PRIVS, ctypes.c_ulong(1), 0, 0, 0), "no_new_privs")


# Parts of /proc the PC's, not the Chumby's, as a container runtime hides
# them: covered (files with /dev/null, directories with an empty tmpfs), or
# read-only.
PROC_MASKED = ("kcore", "keys", "latency_stats", "timer_list", "timer_stats", "sched_debug", "acpi", "asound",
               "scsi")
PROC_READ_ONLY = ("bus", "fs", "irq", "sysrq-trigger")


def pid1(state, root, run, env):
    """PID 1 of the session's namespace: mounts /proc there, then runs the
    session, reaping whatever is orphaned, until the session exits. Only os
    calls after the chroot: nothing of Python's own is reachable there."""
    proc = os.path.join(root, "proc")
    mount("proc", proc, "proc", MS_NOSUID | MS_NODEV | MS_NOEXEC)
    for name in PROC_MASKED:
        p = os.path.join(proc, name)
        if os.path.isdir(p):
            mount("tmpfs", p, "tmpfs", MS_RDONLY | MS_NOSUID | MS_NODEV | MS_NOEXEC, "mode=555")
        elif os.path.exists(p):
            bind("/dev/null", p)
    for name in PROC_READ_ONLY:
        p = os.path.join(proc, name)
        if os.path.exists(p):
            bind(p, p, ro=True)
    # /proc/sys/sense1 is the Chumby's own: a tmpfs over /proc/sys holds it,
    # with the PC's kernel, vm, fs and net (qemu reads vm) bound back in,
    # read-only.
    sys_dir = os.path.join(proc, "sys")
    mount("tmpfs", sys_dir, "tmpfs", MS_NOSUID | MS_NODEV | MS_NOEXEC, "mode=755")
    for d in ("kernel", "vm", "fs", "net"):
        os.mkdir(os.path.join(sys_dir, d))
        bind(f"/proc/sys/{d}", os.path.join(sys_dir, d), ro=True)
    os.mkdir(os.path.join(sys_dir, "sense1"))
    bind(state.at("sense1"), os.path.join(sys_dir, "sense1"))
    mount(None, sys_dir, None, MS_REMOUNT | MS_RDONLY | MS_NOSUID | MS_NODEV | MS_NOEXEC)
    log = os.open(state.at("log"), os.O_WRONLY | os.O_APPEND | os.O_NOFOLLOW)
    null = os.open("/dev/null", os.O_RDWR)
    os.chroot(root)
    os.chdir("/")
    session = os.fork()
    if session == 0:
        os.dup2(null, 0)
        os.dup2(log, 1)
        os.dup2(log, 2)
        try:
            drop_privileges()
            os.execve(run, [run], env)
        except OSError as e:
            os.write(2, f"dev/emulate: {run}: {e.strerror}\n".encode())
        os._exit(127)
    while True:
        pid, status = os.wait()
        if pid == session:
            code = os.waitstatus_to_exitcode(status)
            os._exit(code if code >= 0 else 128 - code)


# The controls.


def ask(state, words):
    if running(state) != "running":
        sys.exit("dev/emulate: not running")
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    here = os.getcwd()
    # A relative path: a socket's path is limited to 107 bytes.
    os.chdir(state.path)
    try:
        s.connect("ctl")
    finally:
        os.chdir(here)
    with s:
        s.sendall(" ".join(words).encode())
        answer = s.makefile().readline().strip()
    if not answer.startswith("ok"):
        sys.exit(f"dev/emulate: {answer}")
    return answer[3:]


def cmd_tap(state, x, y, hold_ms):
    if not (0 <= x < W and 0 <= y < H):
        sys.exit(f"dev/emulate tap: ({x}, {y}) is off the {W}x{H} screen")
    ask(state, ["touch", str(x), str(y)])
    time.sleep(hold_ms / 1000)
    ask(state, ["release"])


def cmd_button(state, how):
    if how == "press":
        ask(state, ["button", "1"])
        time.sleep(0.2)
        ask(state, ["button", "0"])
    elif how in ("down", "up"):
        ask(state, ["button", "1" if how == "down" else "0"])
    else:
        sys.exit("usage: dev/emulate button down|up|press")


def screen(state):
    with open(state.at("fb0"), "rb") as f:
        return f.read(FB_BYTES)


def cmd_pixel(state, x, y):
    (p,) = struct.unpack_from("<H", screen(state), (y * W + x) * 2)
    r, g, b = (p >> 11) & 0x1F, (p >> 5) & 0x3F, p & 0x1F
    # Widened as dev/fb2png.py does.
    print("#%02x%02x%02x" % (r << 3 | r >> 2, g << 2 | g >> 4, b << 3 | b >> 2))


def cmd_compare(state, files, least, secs, want):
    pictures = {}
    for f in files:
        with open(f, "rb") as fh:
            data = fh.read(FB_BYTES + 1)
        if len(data) != FB_BYTES:
            sys.exit(f"dev/emulate compare: {f}: not {FB_BYTES} bytes")
        pictures[os.path.basename(f)] = memoryview(data).cast("H")
    if not pictures:
        sys.exit("usage: dev/emulate compare [--min F] [--wait SECS] [--want RE] RAW ...")
    deadline = time.monotonic() + secs
    while True:
        now = memoryview(screen(state)).cast("H")
        share, name = max((sum(a == b for a, b in zip(now, p)) / (W * H), n) for n, p in pictures.items())
        ok = share >= least and (not want or re.search(want, name))
        if ok or time.monotonic() >= deadline:
            print(f"{share:.2f} {name}")
            if not ok and (secs or least):
                sys.exit(1)
            return
        time.sleep(0.3)


def cmd_wait(state, what, arg, secs):
    deadline = time.monotonic() + secs
    last, since = None, time.monotonic()
    while time.monotonic() < deadline:
        if what == "exit" and read(state, "exit"):
            print(read(state, "exit"))
            return
        if what == "log" and re.search(arg, read(state, "log") or "", re.M):
            return
        if what == "screen":
            now = screen(state)
            if now != last:
                last, since = now, time.monotonic()
            elif any(now) and time.monotonic() - since >= 0.5:
                return
        if what != "exit" and read(state, "exit"):
            sys.exit(f"dev/emulate wait: the session ended ({read(state, 'exit')})")
        time.sleep(0.1)
    sys.exit(f"dev/emulate wait {what}: timed out after {secs:g} s")


def cmd_log(state, follow):
    with open(state.at("log"), "rb") as f:
        while True:
            chunk = f.read()
            if chunk:
                sys.stdout.buffer.write(chunk)
                sys.stdout.flush()
            elif not follow or (running(state) is None and read(state, "exit")):
                return
            else:
                time.sleep(0.2)


def cmd_status(state):
    now = running(state)
    if now == "running":
        print("running")
        for k, v in json.loads(ask(state, ["status"])).items():
            print(f"  {k}: {v}")
        for name in ("brightness", "dimlevel", "spkmute"):
            print(f"  {name}: {read(state, f'sense1/{name}')}")
    elif now == "stale":
        print("stale: the supervisor was killed, but the session's PID 1 still runs (sudo dev/emulate stop)")
    elif read(state, "exit"):
        print(f"stopped: the session ended ({read(state, 'exit')})")
    else:
        print("not running")


def cmd_stop(state):
    now = running(state)
    if now == "stale":
        need_root("stop")
        state.secure()
        init = stale_init(state)
        if init:
            os.kill(init, signal.SIGKILL)
        return
    if now != "running":
        return
    ask(state, ["stop"])
    deadline = time.monotonic() + 10
    while running(state) and time.monotonic() < deadline:
        time.sleep(0.1)


def enter(state, what):
    """Joins the running emulator's namespaces, as root; then `state` is
    opened again there, and checked to be the same directory."""
    need_root(what)
    state.secure()
    init = read(state, "init-pid")
    if running(state) != "running" or not init or not is_ns_init(int(init)):
        sys.exit("dev/emulate: not running")
    namespaces = [(os.open(f"/proc/{init}/ns/{ns}", os.O_RDONLY), flag)
                  for ns, flag in (("mnt", CLONE_NEWNS), ("uts", CLONE_NEWUTS), ("pid", CLONE_NEWPID))]
    for fd, flag in namespaces:
        _check(libc.setns(fd, flag), "setns")
        os.close(fd)
    state.reopen()


def cmd_exec(state, argv, secs):
    if not argv:
        sys.exit("usage: sudo dev/emulate exec [--for SECS] CMD [ARG ...]")
    enter(state, "exec")
    os.chroot(state.at("root"))
    os.chdir("/")
    env = dict(BASE_ENV, HOME="/tmp")
    child = os.fork()
    if child == 0:
        try:
            drop_privileges()
            os.execve(argv[0], argv, env)
        except OSError as e:
            os.write(2, f"dev/emulate exec: {argv[0]}: {e.strerror}\n".encode())
        os._exit(127)

    def forward(sig, _):
        os.kill(child, sig)

    # Ended by --for: however it takes SIGTERM (ours exit 143), that's success.
    ended = []

    def time_up(*_):
        ended.append(True)
        os.kill(child, signal.SIGTERM)

    signal.signal(signal.SIGINT, forward)
    signal.signal(signal.SIGTERM, forward)
    if secs:
        signal.signal(signal.SIGALRM, time_up)
        signal.setitimer(signal.ITIMER_REAL, secs)
    _, status = os.waitpid(child, 0)
    code = os.waitstatus_to_exitcode(status)
    sys.exit(0 if ended else code if code >= 0 else 128 - code)


def cmd_selftest(state):
    """Checks the fake devices' semantics from this side of the emulator,
    through the same files the session opens: the touchscreen's copies, the
    button's level and exclusive open, and the speaker's ioctls and pacing.
    It touches (200, 20), where neochumby-home has nothing."""
    import fcntl

    enter(state, "selftest")
    dev = state.at("root/dev")
    fails = []

    def check(ok, what):
        print(("ok   " if ok else "FAIL ") + what)
        if not ok:
            fails.append(what)

    a = os.open(f"{dev}/input/event0", os.O_RDONLY | os.O_NONBLOCK)
    b = os.open(f"{dev}/input/event0", os.O_RDONLY | os.O_NONBLOCK)
    try:
        os.read(a, 512)
        check(False, "event0: an empty read fails with EAGAIN")
    except BlockingIOError:
        check(True, "event0: an empty read fails with EAGAIN")
    ask(state, ["touch", "200", "20"])
    ask(state, ["release"])
    ra, rb = os.read(a, 512), os.read(b, 512)
    check(len(ra) == 8 * 16 and ra == rb, "event0: every reader gets every event")
    _, _, ty, code, value = struct.unpack_from("<IIHHi", ra)
    check((ty, code, value) == (EV_ABS, ABS_X, raw_point(calibration(state.at("psp")), 200, 20)[0]),
          "event0: the touch is at the calibrated raw position")
    os.close(a)
    os.close(b)

    try:
        s = os.open(f"{dev}/switch", os.O_RDWR | os.O_NONBLOCK)
    except OSError as e:
        print(f"skip /dev/switch: {e.strerror} (the session has it)")
        s = None
    if s is not None:
        try:
            os.open(f"{dev}/switch", os.O_RDONLY | os.O_NONBLOCK)
            check(False, "switch: a second open is refused (EBUSY)")
        except OSError as e:
            check(e.errno == errno.EBUSY, "switch: a second open is refused (EBUSY)")
        ask(state, ["button", "1"])
        check(os.read(s, 1) == b"\x01" and os.read(s, 1) == b"\x01", "switch: each read is the level, held")
        ask(state, ["button", "0"])
        check(os.read(s, 1) == b"\x00", "switch: released")
        try:
            os.write(s, b"\x01")
            check(False, "switch: a write is refused (EINVAL)")
        except OSError as e:
            check(e.errno == errno.EINVAL, "switch: a write is refused (EINVAL)")
        os.close(s)

    try:
        d = os.open(f"{dev}/dsp", os.O_WRONLY)
    except OSError as e:
        print(f"skip /dev/dsp: {e.strerror}")
        d = None
    if d is not None:
        got = []
        for req, v in ((SNDCTL_DSP_SETFMT, AFMT_S16_LE), (SNDCTL_DSP_CHANNELS, 2), (SNDCTL_DSP_SPEED, 22050)):
            got.append(struct.unpack("<i", fcntl.ioctl(d, req, struct.pack("<i", v)))[0])
        check(got == [AFMT_S16_LE, 2, 22050], "dsp: the OSS format ioctls")
        start = time.monotonic()
        for _ in range(10):
            os.write(d, bytes(22050 * 4 // 10))
        took = time.monotonic() - start
        # The writer may run up to the buffer plus one write ahead of the sound.
        check(0.5 < took < 1.5, f"dsp: one second of sound takes about a second ({took:.2f} s)")
        os.close(d)

    # Ways out that root, without its dropped capabilities, hasn't got.
    probe = os.fork()
    if probe == 0:
        os.chroot(state.at("root"))
        drop_privileges()
        outcomes = []
        for attempt in (lambda: os.chroot("/tmp"), lambda: mount("tmpfs", "/tmp", "tmpfs"),
                        lambda: os.open("/proc/sys/vm/drop_caches", os.O_WRONLY)):
            try:
                attempt()
                outcomes.append("allowed")
            except OSError:
                outcomes.append("refused")
        os._exit(0 if outcomes == ["refused"] * 3 else 1)
    _, status = os.waitpid(probe, 0)
    check(os.waitstatus_to_exitcode(status) == 0,
          "inside: chroot, mount and writes to /proc/sys are refused")
    if fails:
        sys.exit(f"{len(fails)} failed")


def cmd_mkstick(img, size_mb, tree, force):
    """A FAT image at IMG, a regular file: never a disk, nor through a link."""
    need_root("mkstick")
    mkfs = shutil.which("mkfs.vfat") or shutil.which("mkfs.fat")
    if not mkfs:
        sys.exit("dev/emulate mkstick: needs mkfs.vfat (dosfstools)")
    try:
        st = os.lstat(img)
    except FileNotFoundError:
        st = None
    if st and not stat.S_ISREG(st.st_mode):
        sys.exit(f"dev/emulate mkstick: {img} isn't a regular file; refusing")
    if st and not force:
        sys.exit(f"dev/emulate mkstick: {img} exists; --force to overwrite it")
    fd = os.open(img, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | (0 if st else os.O_EXCL), 0o644)
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        sys.exit(f"dev/emulate mkstick: {img} isn't a regular file; refusing")
    os.ftruncate(fd, 0)
    os.ftruncate(fd, size_mb << 20)
    # The user's own file, as if they had made it.
    os.fchown(fd, *invoker())
    path = f"/proc/self/fd/{fd}"
    subprocess.run([mkfs, "-n", "NEOCHUMBY", path], check=True, stdout=subprocess.DEVNULL, pass_fds=(fd,))
    if not tree:
        return
    pid = os.fork()
    if pid == 0:
        code = 1
        try:
            unshare(CLONE_NEWNS)
            mount(None, "/", None, MS_REC | MS_PRIVATE)
            mnt = tempfile.mkdtemp(prefix="neochumby-stick.")
            subprocess.run(["mount", "-t", "vfat", "-o", "loop", path, mnt], check=True, pass_fds=(fd,))
            # As tools/stick lays it out: the tree, and the hook at the top.
            subprocess.run(["cp", "-R", os.path.abspath(tree), os.path.join(mnt, "neochumby")], check=True)
            shutil.copy(os.path.join(tree, "userhook2"), os.path.join(mnt, "userhook2"))
            subprocess.run(["umount", mnt], check=True)
            os.rmdir(mnt)
            code = 0
        finally:
            os._exit(code)
    _, status = os.waitpid(pid, 0)
    if os.waitstatus_to_exitcode(status):
        sys.exit("dev/emulate mkstick: copying the tree failed")


USAGE = "usage: dev/emulate [--state DIR] COMMAND ... (dev/emulate --help)"


def main(argv):
    def flag(args, name, default=None):
        """The value after `name` in args, taken out of them."""
        if name not in args:
            return default
        i = args.index(name)
        if i + 1 >= len(args):
            sys.exit(f"dev/emulate: {name} needs a value")
        v = args[i + 1]
        del args[i:i + 2]
        return v

    def number(v, kind=int):
        try:
            return kind(v)
        except (TypeError, ValueError):
            sys.exit(f"dev/emulate: not a number: {v}")

    argv = list(argv)
    uid, _ = invoker()
    path = flag(argv, "--state") or os.environ.get("NEOCHUMBY_EMU") or f"/var/tmp/neochumby-emulate-{uid}"
    state = State(path)
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmd, args = argv[0], argv[1:]

    def operands(n, usage):
        if len(args) < n:
            sys.exit(f"usage: dev/emulate {usage}")
        return args[:n]

    if cmd == "start":
        stick = flag(args, "--stick")
        opts = {
            "stick": stick and os.path.abspath(stick),
            "server": flag(args, "--server"),
            "psp": flag(args, "--psp"),
            "run": flag(args, "--run"),
        }
        env = {}
        while "--env" in args:
            k, _, v = flag(args, "--env").partition("=")
            env[k] = v
        opts["env"] = env
        binds = []
        while "--bind" in args:
            host, _, guest = flag(args, "--bind").partition(":")
            if not os.path.isdir(host) or not guest.startswith("/"):
                sys.exit("dev/emulate start: --bind DIR:/PATH, DIR a directory")
            binds.append((os.path.abspath(host), guest))
        opts["binds"] = binds
        cmd_start(state, opts, args[0] if args else None)
    elif cmd == "tap":
        hold = number(flag(args, "--hold", "100"))
        x, y = operands(2, "tap X Y [--hold MS]")
        cmd_tap(state, number(x), number(y), hold)
    elif cmd == "button":
        cmd_button(state, args[0] if args else "")
    elif cmd == "shot":
        (out,) = operands(1, "shot OUT.png")
        subprocess.run([sys.executable, "-I", os.path.join(REPO, "dev", "fb2png.py"), state.at("fb0"), out],
                       check=True)
    elif cmd == "pixel":
        x, y = operands(2, "pixel X Y")
        x, y = number(x), number(y)
        if not (0 <= x < W and 0 <= y < H):
            sys.exit(f"dev/emulate pixel: ({x}, {y}) is off the screen")
        cmd_pixel(state, x, y)
    elif cmd == "compare":
        least, secs = number(flag(args, "--min", "0"), float), number(flag(args, "--wait", "0"), float)
        cmd_compare(state, args, least, secs, flag(args, "--want"))
    elif cmd == "log":
        cmd_log(state, "-f" in args)
    elif cmd == "wait":
        (what,) = operands(1, "wait screen|exit [SECS] | wait log REGEX [SECS]")
        pattern = None
        if what == "log":
            _, pattern = operands(2, "wait log REGEX [SECS]")
            del args[1]
        elif what not in ("screen", "exit"):
            sys.exit("usage: dev/emulate wait screen|exit [SECS] | wait log REGEX [SECS]")
        cmd_wait(state, what, pattern, number(args[1], float) if len(args) > 1 else 30)
    elif cmd == "status":
        cmd_status(state)
    elif cmd == "stop":
        cmd_stop(state)
    elif cmd == "exec":
        secs = number(flag(args, "--for", "0"), float)
        cmd_exec(state, args, secs)
    elif cmd == "selftest":
        cmd_selftest(state)
    elif cmd == "mkstick":
        size, force = number(flag(args, "--size", "64")), "--force" in args
        args = [a for a in args if a != "--force"]
        if not args:
            sys.exit("usage: sudo dev/emulate mkstick IMG [--size MB] [--force] [TREE]")
        cmd_mkstick(args[0], size, args[1] if len(args) > 1 else None, force)
    else:
        sys.exit(f"dev/emulate: unknown command {cmd}\n{USAGE}")


if __name__ == "__main__":
    main(sys.argv[1:])
